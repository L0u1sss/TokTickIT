generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

enum Status {
  NEW
}

enum UserRole {
  REQUESTER
  IT_STAFF
  ADMINISTRATOR
}

// Authentication foundation (#30). RequesterUser/Ticket/Attachment migration
// and their authenticated access cutover are implemented together in #31.
model User {
  id                 Int       @id @default(autoincrement())
  displayName        String    @db.VarChar(120)
  email              String    @unique @db.VarChar(254)
  passwordHash       String
  role               UserRole
  isActive           Boolean   @default(true)
  mustChangePassword Boolean   @default(true)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  sessions           Session[]
}

model Session {
  id        Int       @id @default(autoincrement())
  tokenHash String    @unique @db.Char(64)
  userId    Int
  expiresAt DateTime
  createdAt DateTime  @default(now())
  revokedAt DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
}

model RequesterUser {
  id                  Int          @id @default(autoincrement())
  displayName         String       @db.VarChar(120)
  email               String       @unique @db.VarChar(254)
  isActive            Boolean      @default(true)
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  tickets             Ticket[]
  uploadedAttachments Attachment[] @relation("AttachmentUploader")
  removedAttachments  Attachment[] @relation("AttachmentRemover")

  @@index([isActive, displayName])
}

model Category {
  id        Int      @id @default(autoincrement())
  name      String   @unique @db.VarChar(120)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tickets   Ticket[]

  @@index([isActive, name])
}

model RelatedSystem {
  id          Int      @id @default(autoincrement())
  name        String   @unique @db.VarChar(120)
  description String?  @db.VarChar(500)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tickets     Ticket[]

  @@index([isActive, name])
}

model Ticket {
  id                Int           @id @default(autoincrement())
  ticketNumber      String        @unique @db.VarChar(15)
  clientRequestId   String        @unique @db.Uuid
  summary           String        @db.VarChar(120)
  description       String        @db.VarChar(2000)
  requestedPriority Priority
  status            Status        @default(NEW)
  requesterId       Int
  categoryId        Int
  relatedSystemId   Int
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  requester         RequesterUser @relation(fields: [requesterId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  category          Category      @relation(fields: [categoryId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  relatedSystem     RelatedSystem @relation(fields: [relatedSystemId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  attachments       Attachment[]

  @@index([requesterId])
  @@index([categoryId])
  @@index([relatedSystemId])
  @@index([requesterId, createdAt(sort: Desc)])
  @@index([requesterId, status, createdAt(sort: Desc)])
  @@index([requesterId, requestedPriority, createdAt(sort: Desc)])
  @@index([requesterId, categoryId, createdAt(sort: Desc)])
  @@index([requesterId, relatedSystemId, createdAt(sort: Desc)])
}

model Attachment {
  id                    Int            @id @default(autoincrement())
  ticketId              Int
  originalName          String         @db.VarChar(255)
  storageKey            String         @unique
  sizeBytes             Int
  mimeType              String         @db.VarChar(100)
  uploadedByRequesterId Int
  createdAt             DateTime       @default(now())
  removedAt             DateTime?
  removalReason         String?        @db.VarChar(500)
  removedByRequesterId  Int?
  ticket                Ticket         @relation(fields: [ticketId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  uploadedBy            RequesterUser  @relation("AttachmentUploader", fields: [uploadedByRequesterId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  removedBy             RequesterUser? @relation("AttachmentRemover", fields: [removedByRequesterId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([ticketId])
  @@index([uploadedByRequesterId])
  @@index([removedByRequesterId])
  @@index([ticketId, removedAt, createdAt])
}
